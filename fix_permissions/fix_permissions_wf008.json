{
  "description": "Configuração para correção de permissões no servidor WF008 - Base app_workforce",
  "version": "1.0.0",
  "databases": [
    {
      "name": "app_workforce",
      "type": "postgres",
      "server": "wf008",
      "owner": "journey_system",
      "description": "Banco de dados App Workforce - Sistema de RH",
      "operations": [
        {
          "type": "grant_privileges",
          "target": "database",
          "database": "app_workforce",
          "user": "journey_system",
          "privileges": [
            "CONNECT",
            "CREATE",
            "TEMP"
          ]
        },
        {
          "type": "grant_privileges",
          "target": "schema",
          "schema": "public",
          "user": "journey_system",
          "privileges": [
            "USAGE",
            "CREATE"
          ]
        },
        {
          "type": "grant_privileges",
          "target": "all_tables",
          "schema": "public",
          "user": "journey_system",
          "privileges": [
            "SELECT",
            "INSERT",
            "UPDATE",
            "DELETE"
          ]
        },
        {
          "type": "grant_privileges",
          "target": "all_sequences",
          "schema": "public",
          "user": "journey_system",
          "privileges": [
            "USAGE",
            "SELECT",
            "UPDATE"
          ]
        },
        {
          "type": "set_default_privileges",
          "target": "tables",
          "schema": "public",
          "user": "journey_system",
          "privileges": [
            "SELECT",
            "INSERT",
            "UPDATE",
            "DELETE"
          ]
        },
        {
          "type": "set_default_privileges",
          "target": "sequences",
          "schema": "public",
          "user": "journey_system",
          "privileges": [
            "USAGE",
            "SELECT",
            "UPDATE"
          ]
        }
      ]
    }
  ],
  "connection": {
    "config_file": "secrets/wf008-postgresql_source_config.json",
    "server": {
      "host": "wf008.vya.digital",
      "port": 5432
    },
    "authentication": {
      "user": "migration_user",
      "method": "password"
    }
  },
  "verification": {
    "enabled": true,
    "checks": [
      "user_exists",
      "privileges"
    ]
  }
}
